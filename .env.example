# Optional: "save to your own storage" accounts. See docs/ACCOUNT-SYNC.md.
# These are public client ids, not secrets. The feature has no client secret
# anywhere by design, because a static export cannot keep one.
# Leave them unset and the app works exactly as before, minus cloud saving.

# Google Drive, web build. Authorized origins must include the deployed site
# and http://localhost:9002 for dev.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Drive, Tauri desktop build (a "Desktop app" OAuth client). Required
# for desktop sign-in: the web id above cannot stand in, because Google rejects
# a 127.0.0.1 redirect on a Web client.
NEXT_PUBLIC_GOOGLE_DESKTOP_CLIENT_ID=

# The matching secret for that Desktop-app client. Google's token endpoint
# demands it even with PKCE, and Google's own installed-app docs ship it inside
# the binary, so this is the one "secret" here and it is not a real one. Never
# put a Web client's secret in this file: that one is genuinely confidential.
NEXT_PUBLIC_GOOGLE_DESKTOP_CLIENT_SECRET=

# GitHub gists, desktop device flow only (no secret needed).
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# GitHub sign-in Worker, which turns the web GitHub option into a real login
# button. Deploy workers/github-oauth and put its URL here. Leave it unset and
# the web build asks the user to paste a personal access token instead.
NEXT_PUBLIC_GITHUB_OAUTH_PROXY=

# Translation API Servers
# Defaults to trybooks.org (primary) and ludowala.app (fallback) if unset.
NEXT_PUBLIC_TRANSLATION_PRIMARY_URL=
NEXT_PUBLIC_TRANSLATION_FALLBACK_URL=
