{
  "name": "open-screenshot-generator-promo",
  "version": "0.1.0",
  "private": true,
  "description": "Remotion promo video for Open Screenshot Generator",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Promo out/open-screenshot-generator-promo.mp4",
    "render:fast": "remotion render PromoFast out/open-screenshot-generator-promo-fast.mp4",
    "render:mobile": "remotion render PromoMobile out/open-screenshot-generator-promo-mobile.mp4",
    "render:ai": "remotion render PromoAI out/open-screenshot-generator-promo-ai.mp4",
    "render:ai-mobile": "remotion render PromoAIMobile out/open-screenshot-generator-promo-ai-mobile.mp4",
    "render:steps": "remotion render PromoSteps out/open-screenshot-generator-promo-steps.mp4",
    "render:vs": "remotion render PromoVs out/open-screenshot-generator-promo-vs.mp4 --crf=17",
    "render:vs-mobile": "remotion render PromoVsMobile out/open-screenshot-generator-promo-vs-mobile.mp4 --crf=17",
    "capture:vs": "node scripts/capture-vs.js && node scripts/capture-vs2.js && node scripts/capture-vs3.js && node scripts/crop-vs.js",
    "gen:music": "node scripts/gen-music.js",
    "gen:music-steps": "node scripts/gen-music-steps.js",
    "gen:music-vs": "node scripts/gen-music-vs.js",
    "still": "remotion still Promo"
  },
  "dependencies": {
    "@react-three/fiber": "^8.18.0",
    "@remotion/cli": "4.0.489",
    "@remotion/google-fonts": "4.0.489",
    "@remotion/three": "^4.0.489",
    "@types/three": "^0.185.1",
    "gsap": "^3.15.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.489",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
