<?xml version="1.0" encoding="utf-8"?>
<!--
  The Microsoft Store package manifest. scripts/msix-pack.mjs fills in the
  {{...}} fields from tauri.conf.json (version, product name, description) and
  packs it with the release exe and Assets/. See docs/DESKTOP.md.

  AppData is left virtualized, the default for a packaged app. The exe notices
  it runs inside a package and keeps its data under an identifier of its own
  (src-tauri/src/store_package.rs), so nothing it writes overlaps the
  installer build's folders. Do not add the restricted unvirtualizedResources
  capability back: the Store turned it down for this app (policy 10.6.3).

  The three Identity values below come from Partner Center: the app, then
  Product management, then Product identity. Copy them exactly; the Store
  rejects an upload whose identity differs in any character. The pack script
  refuses to build while a PASTE_FROM_PARTNER_CENTER value is left.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!-- Package/Identity/Name and Package/Identity/Publisher. Version is x.y.z.0:
       the Store keeps the fourth part for itself and the first cannot be 0. -->
  <Identity
    Name="21053IdreesKhan.OpenScreenshotGenerator"
    Publisher="CN=90021D21-000D-4002-87F7-57BEDA78C89F"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>{{DISPLAY_NAME}}</DisplayName>
    <!-- Package/Properties/PublisherDisplayName -->
    <PublisherDisplayName>Idrees Khan</PublisherDisplayName>
    <Description>{{DESCRIPTION}}</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <Capability Name="internetClient" />
    <!-- The exe is a classic Win32 app, so it runs as full trust. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="OpenScreenshotGenerator" Executable="{{EXECUTABLE}}" EntryPoint="Windows.FullTrustApplication">
      <!-- BackgroundColor is the middle of the icon gradient. The tiles are
           opaque, so it only shows behind the splash image. -->
      <uap:VisualElements
        DisplayName="{{DISPLAY_NAME}}"
        Description="{{DESCRIPTION}}"
        BackgroundColor="#5A999B"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <!-- Windows 10 writes the app name along the bottom of the medium and
             wide tiles. Those two PNGs have the glyph raised to leave room. -->
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\SmallTile.png"
          Square310x310Logo="Assets\LargeTile.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
