# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (any folder, incl. promo/)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# companion extension build output (npm run build:extension)
/extension/dist/

# promo video renders (npm run render in promo/)
# /promo/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.genkit/*
.env*
# ...but the template of which public client ids to set is meant to be shared.
!.env.example

# firebase
firebase-debug.log
firestore-debug.log

# tauri
/src-tauri/target/
/src-tauri/gen/schemas/
*.provisionprofile
# generated by build:assistant-agent (runs from tauri.conf.json before commands)
/src-tauri/assistant/agent.js

# the community backend's state, on the VPS and on a local run.
# pb-data is the database AND every uploaded screenshot: it is the one thing in
# infra/vps that cannot be recreated from this repo, and the one thing that must
# never be in it. THIS REPOSITORY IS PUBLIC.
/infra/vps/pb-data/
/infra/vps/caddy-data/
/infra/vps/caddy-config/
/infra/vps/.env
# the deploy key for the VPS. It lives outside this repo; this is a backstop
# against a copy being dropped in by hand.
/infra/vps/*.pem
/infra/vps/id_*
# the PocketBase superuser's email and password, written by the first-run step in
# infra/vps/README.md. It belongs on the box at /opt/openscreengen/.pb-superuser
# and nowhere else. Unanchored, so it is caught wherever a copy lands.
.pb-superuser
